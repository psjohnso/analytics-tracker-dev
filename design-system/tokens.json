{
  "$comment": "Machine-readable mirror of the design tokens in src/app.css :root. Source of truth is src/app.css; keep this in sync. Use via var(--token) in CSS — never hardcode hex in new styles.",
  "brand": {
    "navy":   { "value": "#002669", "css": "--navy",   "role": "Innovation Blue — primary anchor (re-colored per theme)" },
    "orange": { "value": "#C24200", "css": "--orange", "role": "Sunset Orange — action / energy" },
    "yellow": { "value": "#FFDB22", "css": "--yellow", "role": "Sun Yellow — HIGHLIGHT ONLY, sparingly" },
    "green":  { "value": "#83AC16", "css": "--green",  "role": "Saguaro Green — positive" },
    "sky":    { "value": "#0088FF", "css": "--sky",    "role": "Sky Blue — links / interactive" },
    "cactus": { "value": "#9E0059", "css": "--cactus", "role": "Cactus Fruit — bold accent" },
    "sand":   { "value": "#E5D086", "css": "--sand",   "role": "Sonoran Sand — warm accent" },
    "night":  { "value": "#140233", "css": "--night",  "role": "Night Sky — deep accent" }
  },
  "surface": {
    "surface":   { "value": "#F7F5EF", "css": "--surface",   "role": "page background" },
    "surface-2": { "value": "#F3F1EB", "css": "--surface-2", "role": "recessed insets (also aliased as --bg-surface)" },
    "white":     { "value": "#FFFFFF", "css": "--white",     "role": "card / control background (dark grey in dark mode)" },
    "border":    { "value": "#E1E2DD", "css": "--border",    "role": "borders / dividers" }
  },
  "text": {
    "text-body":  { "value": "#002855", "css": "--text-body",  "role": "body text" },
    "text-dark":  { "value": "#002855", "css": "--text-dark",  "role": "headings" },
    "text-muted": { "value": "#6B7280", "css": "--text-muted", "role": "secondary text" }
  },
  "layout": {
    "header-h":     { "value": "64px",  "css": "--header-h",     "role": "top header height (sticky offsets depend on it)" },
    "sidebar-w":    { "value": "280px", "css": "--sidebar-w",    "role": "filter sidebar width" },
    "radius":       { "value": "16px",  "css": "--radius",       "role": "cards / large surfaces" },
    "radius-btn":   { "value": "6px",   "css": "--radius-btn",   "role": "buttons / inputs" },
    "card-padding": { "value": "28px",  "css": "--card-padding", "role": "card inner spacing" }
  },
  "pills": {
    "blue":   { "bg": "#EEF2FF", "fg": "#002669", "css": ["--pill-blue-bg", "--pill-blue-fg"] },
    "orange": { "bg": "#FFF7ED", "fg": "#9A3412", "css": ["--pill-orange-bg", "--pill-orange-fg"] },
    "green":  { "bg": "#F0FDF4", "fg": "#166534", "css": ["--pill-green-bg", "--pill-green-fg"] },
    "purple": { "bg": "#FDF4FF", "fg": "#86198F", "css": ["--pill-purple-bg", "--pill-purple-fg"] },
    "amber":  { "bg": "#FFFBEB", "fg": "#92400E", "css": ["--pill-amber-bg", "--pill-amber-fg"] },
    "cyan":   { "bg": "#F0F9FF", "fg": "#0C4A6E", "css": ["--pill-cyan-bg", "--pill-cyan-fg"] }
  },
  "fonts": {
    "$comment": "Loaded via Google Fonts in index.html. See COT_DESIGN.md.",
    "headings": { "family": "Lato", "fallback": "Arial, sans-serif", "weights": [300, 400, 700, 900], "use": "headings, labels, navigation, UI" },
    "body":     { "family": "Cardo", "fallback": "Georgia, serif", "weights": [400, 700], "use": "body copy, long-form text" }
  },
  "themes": {
    "$comment": "Applied via body[data-theme]; each overrides only navy/orange/surface (dark overrides structural tokens fully). See tokens.css for the dark + colorblind full sets.",
    "default":  { "navy": "#002669", "orange": "#C24200", "surface": "#F7F5EF" },
    "sonoran":  { "navy": "#8B3A1A", "orange": "#F77F00", "surface": "#FFF4DC" },
    "twilight": { "navy": "#3D2660", "orange": "#C2185B", "surface": "#F5EFFA" },
    "pueblo":   { "navy": "#7A3520", "orange": "#D77845", "surface": "#FAEED9" },
    "saguaro":  { "navy": "#2D4F1E", "orange": "#C04020", "surface": "#EDF1E2" },
    "dark":     { "navy": "#6E9BD6", "orange": "#E8633A", "surface": "#14171D", "white": "#20242C", "border": "#343B45", "text-body": "#E6E9ED", "text-muted": "#9AA2AC" }
  },
  "colorblindSafe": {
    "$comment": "body.cb-safe — stacks on any theme.",
    "green": "#009E73", "orange": "#E69F00", "yellow": "#F0E442", "sky": "#56B4E9", "cactus": "#CC79A7", "sand": "#999999"
  }
}
